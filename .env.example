# FlowSync AI Environment Variables
# Copy this file to .env.local and fill in your actual values

# Google AI Studio API Configuration
REACT_APP_GOOGLE_API_KEY=your_google_api_key_here
REACT_APP_GOOGLE_MODEL_NAME=gemini-1.5-pro

# Stripe Payment Configuration
REACT_APP_STRIPE_PUBLIC_KEY=pk_live_your_public_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Database Configuration (Optional - for future backend)
DATABASE_URL=postgresql://user:password@localhost:5432/flowsync_ai

# Application Configuration
REACT_APP_API_URL=https://wernerai.se
REACT_APP_ENVIRONMENT=production
REACT_APP_LOG_LEVEL=info

# Email Configuration (Optional - for future email service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Analytics Configuration (Optional)
REACT_APP_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Feature Flags
REACT_APP_ENABLE_REFERRAL_PROGRAM=true
REACT_APP_ENABLE_A_B_TESTING=true
